# 复制本文件为 .env，然后按需填写：cp .env.example .env
# 启动方式：node --env-file=.env server.js

# 后端端口
PORT=9100

# ---------- 知识库（RAGFlow） ----------
# RAGFlow 服务地址（默认 http://localhost:80，部署到服务器后改成实际地址）
RAGFLOW_BASE_URL=http://localhost:80
# RAGFlow API Key（在 RAGFlow 后台「API」页生成）
RAGFLOW_API_KEY=
# 知识库 dataset id，多个用英文逗号分隔；留空则走本地「分析资料」文本匹配兜底
RAGFLOW_DATASET_IDS=

# ---------- 联网搜索（方案B：知识库未命中时兜底） ----------
# 搜索提供商：tavily | duckduckgo（duckduckgo 免 key，但结果质量一般）
SEARCH_PROVIDER=duckduckgo
# Tavily API Key（https://tavily.com 免费注册，结果质量更好，推荐）
TAVILY_API_KEY=

# ---------- 本地兜底 ----------
# 本地「分析资料」目录路径（默认自动定位到 ../分析资料，一般不用改）
# LOCAL_KB_DIR=
